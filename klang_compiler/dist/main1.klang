class Book:
    _ctr(name kism<str>, year kism<int>):
        mera.name = name
        mera.year = year
    _str() return kare str:
        return "Kitaab(naam: '${mera.name}', saal: ${mera.year})"
book kism<Book> = Book("Meri Kitaab", 2011)
print(book)

