instruction Vehicle:
	model: str optional
	release: int optional
	@follow
	fc go_up() -> none: ...
	@follow
	fc go_down() -> none: ...
	
instruction Person:
	name: str
	age: int
	# introduce "ho"
type Person = {
    "name": str,
    "age": int,
    2: int
}
person: Person = {
    name-> "Warren"
    age-> 25
}
print "${person is}"

class Car from Vehicle:
	fc go_up() -> none:
		return 
	fc go_down() -> none:
		return 
print(Car he kism Vehicle)
