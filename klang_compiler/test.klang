cls Parent:
	called: bool = No
	fc __ctr(this):
		this.called = Yes
		print("you've either instantiated the Parent, or a sub-class of it")
	fc __str(this):
		return "Parent(...)"

@extend
cls TestClass of Parent:
    fc __ctr(this):
    	mom.call()
    	print(this.called)
    @reimplement fc __str(this):
        return "Child(...)"
    fc string(this):
    	return this.__str()

