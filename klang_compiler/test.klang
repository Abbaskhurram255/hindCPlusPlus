class Parent:
	class sub:
		x = "I am in a nested class"
	called: bool = No
	_ctr():
		this.called = Yes
		print("you've either instantiated the Parent, or a sub-class of it")
	_str() return_kare str:
		return "Parent(...)"
	@callme
	fc create_instance(cls) return_kare Khud ko:
		ret cls()
print(Parent.create_instance())
print(Parent?.called)

print(5 guna 4)
print(pone 4 + sawa 2 + 1so)
class TestClass from Parent:
    _ctr():
    	mom.call()
    	print(this.called)
    @nae_sire _str() -> str:
        return "Child(...)"
    method string() -> str:
    	return ._str()
class Friend:
	_ctr(name: str, closeness: float, still_around: haal = Han) return_kare Mujhe:
		my.name = Str(name)
		my.closeness = Flt(closeness)
		me.still_around = bool(still_around)
	_str() return_kare str:
		out "${my._class_name}<name=${my.name}, closeness=${my.closeness}, ${me.still_around}>"
friend: Friend = naya Friend("Muneer", 70 %)
print(friend)
print(friend._str())
print((8)._cls)
print((8)._class_name)
print(friend._cls)
print(friend._class_name)
